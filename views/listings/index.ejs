<% layout('layouts/boilerplate.ejs') -%>


<div class="filters-wrapper">
  <button class="scroll-btn left" id="scrollLeft">
    <i class="fa-solid fa-angle-left"></i>
  </button>

  <div id="filters">
    <div class="filter" data-category="Trending">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter" data-category="Rooms">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>
    <div class="filter" data-category="Iconic-Cities">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic cities</p>
    </div>
    <div class="filter" data-category="Mountains">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
    </div>
    <div class="filter" data-category="Castles">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p>
    </div>
    <div class="filter" data-category="Amazing-pools">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing pools</p>
    </div>
    <div class="filter" data-category="Camping">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </div>
    <div class="filter" data-category="Farms">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>Farms</p>
    </div>
    <div class="filter" data-category="Arctic">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </div>
    <div class="filter" data-category="Domes">
      <div><i class="fa-solid fa-igloo"></i></div>
      <p>Domes</p>
    </div>
    <div class="filter" data-category="Boats">
      <div><i class="fa-solid fa-ship"></i></div>
      <p>Boats</p>
    </div>
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input
          class="form-check-input"
          type="checkbox"
          id="flexSwitchCheckDefault"
        />
        <label class="form-check-label" for="flexSwitchCheckDefault"
          >display total after taxes</label
        >
      </div>
    </div>
  </div>

  <button class="scroll-btn right" id="scrollRight">
    <i class="fa-solid fa-angle-right"></i>
  </button>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 noListing">
  <% if (AllListings.length === 0) { %>

  <div class="col-12 text-center mt-5">
    <h3>No listings found 😕</h3>

    <% if (category) { %>
    <p>There are no listings in <b><%= category %></b> category.</p>
    <% } else { %>
    <p>No listings available right now.</p>
    <% } %>

    <a href="/listings" class="btn btn-dark mt-3">Browse All Listings</a>
  </div>

  <% } else{ %> <% for(listing of AllListings) { %>
  <a href="/listings/<%= listing._id %>" class="showA">
    <div class="card listing-card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top"
        alt="listing_image"
        style="height: 20rem"
      />
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <b><%=listing.title %></b> <br />
          &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
          <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
        </p>
      </div>
    </div>
  </a>
  <% } %> <% } %>
</div>


