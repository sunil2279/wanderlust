<% layout('layouts/boilerplate') %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>Create new listing</h3>

    <form
      action="/listings"
      method="POST"
      enctype="multipart/form-data"
      class="needs-validation"
      novalidate
    >
      <div class="row">
        <div class="md-3 col-mb-4 col-4">
          <label class="form-label">Enter title</label>
          <input
            name="listing[title]"
            type="text"
            class="form-control"
            required
          />
        </div>

        <div class="md-3 col-md-8 col-8" >
          <label class="form-label">Select Category</label>
          <select name="listing[category]"class="form-select" required>
          <option >Select Category</option>
          <option value="Trending">Trending</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic-Cities">Iconic Cities</option>
          <option value="Mountains">Mountains</option>
          <option value="Castles">Castles</option>
          <option value="Amazing-Pools">Amazing Pools</option>
          <option value="Camping">Camping</option>
          <option value="Farms">Farms</option>
          <option value="Arctic">Arctic</option>
          <option value="Domes">Domes</option>
          <option value="Boats">Boats</option>
        </select>
        </div>
        
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          required
        ></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Upload Listing Image</label>
        <input
          type="file"
          name="listing[image][url]"
          class="form-control"
          required
        />
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label class="form-label">Price</label>
          <input
            type="number"
            name="listing[price]"
            class="form-control"
            required
          />
        </div>

        <div class="mb-3 col-md-8">
          <label class="form-label">Country</label>
          <input
            type="text"
            name="listing[country]"
            class="form-control"
            required
          />
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Location</label>
        <input
          type="text"
          name="listing[location]"
          class="form-control"
          required
        />
      
        <input type="hidden" name="listing[lat]" id="lat" />
        <input type="hidden" name="listing[lng]" id="lng" />
        <div class="createNewMap">
          <div id="map" style="height: 300px"></div>
        </div>
        
      </div>

      <button class="btn btn-dark mt-3">Add</button>
    </form>
  </div>
</div>

<script>
  const map = L.map("map").setView([20.5937, 78.9629], 5);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 18,
  }).addTo(map);

  let marker;

  const locationInput = document.querySelector(
    'input[name="listing[location]"]'
  );

  locationInput.addEventListener("change", async () => {
    const place = locationInput.value;

    const res = await fetch(
      `https://nominatim.openstreetmap.org/search?format=json&q=${place}`
    );
    const data = await res.json();

    if (data.length === 0) return;

    const lat = data[0].lat;
    const lng = data[0].lon;

    map.setView([lat, lng], 13);

    if (marker) map.removeLayer(marker);
    marker = L.marker([lat, lng]).addTo(map);

    document.getElementById("lat").value = lat;
    document.getElementById("lng").value = lng;
  });
</script>
